# Skopos — copy to .env and fill in. .env is gitignored. Nothing here is required
# to run the demo: the default mock provider needs no keys and no network.

# Which world-model provider to stream from: mock | reactor | runware
SKOPOS_PROVIDER=mock

# Which perception backend: mock | claude
# "claude" sends scan frames to the Claude API exactly once; "mock" never leaves
# the machine.
SKOPOS_PERCEPTION=mock

# Reactor (reactor.inc) — see docs/PROVIDER_SWAP.md
REACTOR_API_KEY=
REACTOR_MODEL=

# Runware fallback
RUNWARE_API_KEY=

# Vision perception
ANTHROPIC_API_KEY=
SKOPOS_VLM_MODEL=

# Debug only. 1 writes raw frames to disk and shouts about it at startup.
SKOPOS_DEBUG_KEEP_FRAMES=0
