# Skopos — copy to .env and fill in. .env is gitignored. Nothing here is needed
# to run the demo: the default mock provider takes no keys and no network.

# World-model provider: mock | reactor | runware
SKOPOS_PROVIDER=mock

# Campaign size and seed. A campaign is reproducible from its seed.
SKOPOS_SAMPLES=20000
SKOPOS_SEED=20260912

# Reactor (reactor.inc) — see docs/PROVIDER_SWAP.md
REACTOR_API_KEY=
REACTOR_MODEL=

# How the world model gets a layout reference.
#   none (default)  — text prompt only. Measured to give the best output.
#   rendered        — condition on a plan drawn from the scene graph. No camera
#                     pixels leave the device, but measured against
#                     reactor/helios the model inherits the diagram's geometry
#                     at any image_strength and renders the diagram, not a room.
#                     See providers/reactor.py for the measurements.
#   photo           — uploads SKOPOS_REFERENCE_IMAGES. Real pixels leave the
#                     device and the UI says so.
SKOPOS_REFERENCE=none
REACTOR_IMAGE_STRENGTH=0.25
SKOPOS_REFERENCE_IMAGES=

# Runware fallback
RUNWARE_API_KEY=

# Debug only. 1 writes raw frames to disk and shouts about it at startup.
SKOPOS_DEBUG_KEEP_FRAMES=0
